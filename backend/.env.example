# VietVoyage Backend — sao chép thành .env và điền giá trị thật.
PORT=5000
NODE_ENV=development

# Booking dùng MongoDB transaction nên bắt buộc replica set (local hoặc Atlas).
MONGO_URI=mongodb://localhost:27017/vietvoyage?replicaSet=rs0
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRE=7d
JWT_COOKIE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# URL public của FE và origin được phép gọi API (phân tách bằng dấu phẩy).
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
RATE_LIMIT_MAX=300

# URL HTTPS công khai của Backend. Khi dùng Docker + ngrok chỉ cần đặt NGROK_DOMAIN;
# Backend sẽ tự sinh toàn bộ Return URL/IPN URL từ domain đó.
PUBLIC_BASE_URL=
NGROK_DOMAIN=

# Thời hạn giữ chỗ: online mặc định 30 phút, thanh toán sau mặc định 24 giờ.
BOOKING_HOLD_MINUTES=30
LATER_HOLD_MINUTES=1440
PAYMENT_EXPIRY_WARNING_MINUTES=10
TRIP_REMINDER_DAYS=3
BOOKING_EXPIRY_INTERVAL_MS=60000
NOTIFICATION_RETENTION_DAYS=90
UNREAD_NOTIFICATION_RETENTION_DAYS=365

# VNPay Sandbox. TmnCode/HashSecret nhận sau khi đăng ký merchant test.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
# URL này cấu hình trong trang merchant VNPay (backend không gửi nó trong create URL).
VNP_IPN_URL=http://localhost:5000/api/payments/vnpay/ipn

# MoMo Sandbox chính thức. Các key bên dưới phải là key môi trường Test.
MOMO_MODE=sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Hiện trang MoMo các lựa chọn ATM/thẻ để test callback tự động.
MOMO_REQUEST_TYPE=payWithMethod
MOMO_PARTNER_NAME=VietVoyage Test
MOMO_STORE_ID=VietVoyageTestStore
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5000/api/payments/momo/return
MOMO_IPN_URL=http://localhost:5000/api/payments/momo/ipn

# Để trống AI_SERVICE_URL = dùng stub nội bộ. Hai API key dưới phải cùng giá trị
# với AI_INTERNAL_API_KEY của tour-ai-service.
AI_SERVICE_URL=http://tour-ai-service:4000/api/ai
AI_SERVICE_API_KEY=replace_with_shared_internal_ai_key

# Tùy chọn cho script kiểm tra biểu đồ admin (không cần khi chỉ chạy ứng dụng).
FE_URL=http://localhost:5173
CDP_PORT=9222
ADMIN_EMAIL=
ADMIN_PASSWORD=
