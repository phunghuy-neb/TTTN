# ==========================
#  VietVoyage Backend — .env.example
#  Sao chép file này thành .env và điền giá trị thật
# ==========================

PORT=5000
MONGO_URI=mongodb://localhost:27017/vietvoyage
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRE=7d
NODE_ENV=development

# AI service của Tuấn Anh (UC-07). ĐỂ TRỐNG = dùng stub nội bộ.
# Set URL (VD http://localhost:8000) là chat gọi AI thật — không cần sửa code.
AI_SERVICE_URL=
