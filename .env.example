# Cấu hình Docker Compose + ngrok. Sao chép file này thành .env ở thư mục gốc.
# File này KHÔNG chứa key thanh toán. VNP_* và MOMO_* nằm trong backend/.env.
# Lấy hai giá trị đầu tại https://dashboard.ngrok.com/get-started/setup
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-name.ngrok-free.dev

# Domain dùng chung cho giao diện, API và callback Sandbox khi chạy Docker.
PUBLIC_BASE_URL=https://your-name.ngrok-free.dev
CLIENT_URL=https://your-name.ngrok-free.dev
CORS_ORIGINS=http://localhost:5173,https://your-name.ngrok-free.dev

# Dùng đường dẫn tương đối để chạy được qua cả localhost và domain ngrok.
VITE_API_BASE_URL=/api

# Backend gọi AI service nội bộ khi chạy Docker với profile ai.
AI_SERVICE_URL=http://tour-ai-service:4000/api/ai
AI_SERVICE_API_KEY=replace_with_shared_internal_ai_key
