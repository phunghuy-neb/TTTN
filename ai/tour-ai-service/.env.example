# Mongo (dùng chung database với Backend chính)
MONGO_URI=mongodb://localhost:27017/vietvoyage?replicaSet=rs0

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash

# ChromaDB
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=tour_vectors

# AI Service
AI_SERVICE_PORT=4000
AI_INTERNAL_API_KEY=replace_with_same_value_as_backend_AI_SERVICE_API_KEY
AI_RATE_LIMIT_PER_MINUTE=60
