# Mongo (dùng chung database với Backend chính)
# Dùng cùng MongoDB Atlas URI với backend khi chạy Docker.
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/vietvoyage

# Gemini API
GEMINI_PROVIDER_MODE=google
GEMINI_API_KEY=your_gemini_api_key_here
SHOPAIKEY_API_KEY=
SHOPAIKEY_GEMINI_BASE_URL=https://api.shopaikey.com
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash

# ChromaDB
# URL nội bộ Docker Compose; chạy ngoài Docker thì đổi thành http://localhost:8000.
CHROMA_URL=http://chromadb:8000
CHROMA_COLLECTION=tour_vectors
AUTO_RECONCILE_INDEX=true
RAG_MONGO_RECALL_LIMIT=500

# AI Service
AI_SERVICE_PORT=4000
AI_INTERNAL_API_KEY=replace_with_shared_internal_ai_key
AI_RATE_LIMIT_PER_MINUTE=60
